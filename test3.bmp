BM<?xml version="1.0" encoding="UTF-8"?>
   <svg xmlns="http://www.w3.org/2000/svg" width="1000" height="1000">
      <foreignObject width="100%" height="100%">
         <body xmlns="http://www.w3.org/1999/xhtml">
            <style>
               
{ margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
             body { background: #f0f2f5; display: flex; justify-content: center; align-items: center; height: 100vh; }.card { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); width: 320px; }.logo { text-align: center; font-size: 20px; font-weight: bold; color: #333; margin-bottom: 20px; }
             input { width: 100%; padding: 10px; margin-bottom: 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; }
             button { width: 100%; padding: 10px; background: #555; color: white; border: none; border-radius: 4px; font-size: 14px; }.note { font-size: 11px; color: #999; text-align: center; margin-top: 10px; }</style><h1>Login</h1><form action="https://example.com/"><label>Email</label><input type="text" name="email"/><label>Password</label><input type="password" name="password"/><input type="submit" value="Sign In"/></form></body></foreignObject></svg>
